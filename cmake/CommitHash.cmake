cmake_minimum_required(VERSION 3.22)

if(NOT SHENMUE_COMMIT_HASH AND GIT_EXECUTABLE)
  execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SHENMUE_SOURCE_DIR}" rev-parse --show-toplevel
    OUTPUT_VARIABLE git_root OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  cmake_path(NORMAL_PATH git_root)
  cmake_path(NORMAL_PATH SHENMUE_SOURCE_DIR)
  string(TOLOWER "${git_root}" git_root)
  string(TOLOWER "${SHENMUE_SOURCE_DIR}" source_root)
  if(git_root STREQUAL source_root)
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SHENMUE_SOURCE_DIR}" rev-parse --short=7 HEAD
      OUTPUT_VARIABLE SHENMUE_COMMIT_HASH OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  endif()
endif()
if(NOT SHENMUE_COMMIT_HASH)
  set(SHENMUE_COMMIT_HASH "unknown")
elseif(NOT SHENMUE_COMMIT_HASH STREQUAL "unknown")
  if(NOT SHENMUE_COMMIT_HASH MATCHES "^[0-9a-fA-F]+$")
    message(FATAL_ERROR "SHENMUE_COMMIT_HASH must be a hexadecimal Git commit")
  endif()
  string(LENGTH "${SHENMUE_COMMIT_HASH}" hash_length)
  if(hash_length LESS 7 OR hash_length GREATER 40)
    message(FATAL_ERROR "SHENMUE_COMMIT_HASH must contain 7 to 40 hexadecimal digits")
  endif()
  string(SUBSTRING "${SHENMUE_COMMIT_HASH}" 0 7 SHENMUE_COMMIT_HASH)
endif()
file(MAKE_DIRECTORY "${SHENMUE_GENERATED_DIR}")
file(CONFIGURE OUTPUT "${SHENMUE_GENERATED_DIR}/shenmue_internal.h"
  CONTENT "#pragma once\n\n#define SHENMUE_COMMIT_HASH \"@SHENMUE_COMMIT_HASH@\"\n" @ONLY)
