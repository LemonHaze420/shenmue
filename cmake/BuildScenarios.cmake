cmake_minimum_required(VERSION 3.22)
file(MAKE_DIRECTORY "${WORK_DIR}" "${SOURCE_DIR}")
file(LOCK "${WORK_DIR}/build.lock" GUARD PROCESS TIMEOUT 300)

function(run)
  execute_process(COMMAND ${ARGV} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Scenario build failed (${result}): ${ARGV}\n${output}${error}")
  endif()
endfunction()

if(MODE STREQUAL "prepare")
  if(GAME_ROOT)
    run("${EXTRACTOR}" "${GAME_ROOT}" "${CATALOGUE}" "${SOURCE_ROOT}" --missing --match
      [=[/scenario/.*\.scn|/scene/.*/m_[^/]*\.bin|/(motion/motion|misc/m_mobj|misc/m_mdor)\.bin]=])
  endif()
  file(GLOB_RECURSE banks LIST_DIRECTORIES false "${SOURCE_ROOT}/scene/m_*.bin")
  foreach(bank IN ITEMS motion/motion.bin misc/m_mobj.bin misc/m_mdor.bin)
    if(EXISTS "${SOURCE_ROOT}/${bank}")
      list(APPEND banks "${SOURCE_ROOT}/${bank}")
    endif()
  endforeach()
  foreach(bank IN LISTS banks)
    string(REGEX REPLACE "[.]bin$" ".h" header "${bank}")
    if(NOT EXISTS "${header}")
      run("${MOTION}" "${bank}")
    endif()
  endforeach()
  file(GLOB_RECURSE scripts LIST_DIRECTORIES false "${SOURCE_DIR}/*.scn")
  list(FILTER scripts EXCLUDE REGEX "[.]rebuilt[.]scn$")
  foreach(script IN LISTS scripts)
    get_filename_component(directory "${script}" DIRECTORY)
    get_filename_component(name "${script}" NAME_WE)
    if(NOT EXISTS "${directory}/${name}.c" AND NOT EXISTS "${script}.c")
      file(MAKE_DIRECTORY "${WORK_DIR}/decompile")
      set(generated "${WORK_DIR}/decompile/${name}")
      run("${COMPILER}" "${script}" --export-c "${generated}.c")
      run("${CMAKE_COMMAND}" -E copy_if_different "${generated}.c" "${directory}/${name}.c")
      if(NOT EXISTS "${directory}/${name}.h")
        run("${CMAKE_COMMAND}" -E copy_if_different "${generated}.h" "${directory}/${name}.h")
      endif()
      file(REMOVE "${generated}.c" "${generated}.h")
    endif()
  endforeach()
elseif(MODE STREQUAL "compile")
  string(SHA256 output_key "${OUTPUT_DIR}")
  set(manifest "${WORK_DIR}/${output_key}.txt")
  if(EXISTS "${manifest}")
    file(STRINGS "${manifest}" previous)
  endif()
  file(GLOB_RECURSE sources LIST_DIRECTORIES false "${SOURCE_DIR}/*.c")
  file(GLOB_RECURSE headers LIST_DIRECTORIES false "${SOURCE_DIR}/*.h" "${SOURCE_ROOT}/motion/*.h"
    "${SOURCE_ROOT}/misc/m_*.h" "${SOURCE_ROOT}/scene/m_*.h")
  set(active "")
  set(records "")
  foreach(source IN LISTS sources)
    file(READ "${source}" first_line LIMIT 512)
    string(ASCII 239 187 191 bom)
    string(REGEX REPLACE "^${bom}" "" first_line "${first_line}")
    string(FIND "${first_line}" "\n" line_end)
    if(NOT line_end EQUAL -1)
      string(SUBSTRING "${first_line}" 0 ${line_end} first_line)
    endif()
    if(NOT first_line MATCHES "^[ \t]*//[ \t]*override[ \t\r]*$")
      continue()
    endif()
    get_filename_component(name "${source}" NAME_WE)
    if(NOT name MATCHES "^[A-Za-z0-9_]+$" OR "${name}.scn" IN_LIST active)
      message(FATAL_ERROR "Invalid or duplicate scenario name: ${source}")
    endif()
    set(output "${OUTPUT_DIR}/${name}.scn")
    set(rebuild false)
    if(NOT EXISTS "${output}" OR "${source}" IS_NEWER_THAN "${output}" OR "${COMPILER}" IS_NEWER_THAN "${output}")
      set(rebuild true)
    endif()
    foreach(header IN LISTS headers)
      if("${header}" IS_NEWER_THAN "${output}")
        set(rebuild true)
      endif()
    endforeach()
    if(rebuild)
      file(MAKE_DIRECTORY "${OUTPUT_DIR}")
      set(temporary "${WORK_DIR}/${output_key}-${name}.scn")
      run("${COMPILER}" "${source}" -I "${SOURCE_ROOT}" --target pc --emit vm -o "${temporary}")
      run("${CMAKE_COMMAND}" -E copy_if_different "${temporary}" "${output}")
      file(REMOVE "${temporary}")
      file(TOUCH "${output}")
    endif()
    file(SHA256 "${output}" hash)
    list(APPEND active "${name}.scn")
    string(APPEND records "${name}.scn|${hash}\n")
  endforeach()
  foreach(record IN LISTS previous)
    if(record MATCHES "^([A-Za-z0-9_]+[.]scn)[|]([0-9a-f]+)$")
      set(name "${CMAKE_MATCH_1}")
      set(hash "${CMAKE_MATCH_2}")
      if(NOT name IN_LIST active AND EXISTS "${OUTPUT_DIR}/${name}")
        file(SHA256 "${OUTPUT_DIR}/${name}" current_hash)
        if(NOT current_hash STREQUAL hash)
          message(FATAL_ERROR "Previously built scenario has been modified: ${OUTPUT_DIR}/${name}")
        endif()
        file(REMOVE "${OUTPUT_DIR}/${name}")
      endif()
    endif()
  endforeach()
  file(WRITE "${manifest}" "${records}")
else()
  message(FATAL_ERROR "Unknown scenario build mode: ${MODE}")
endif()
