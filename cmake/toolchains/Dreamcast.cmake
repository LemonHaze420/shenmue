set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR SH4)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(SHENMUE_BUILD_DREAMCAST ON CACHE BOOL "Build for Dreamcast")

get_filename_component(_shenmue_source_dir "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
set(SHENMUE_DC_TOOLCHAIN_ROOT "${_shenmue_source_dir}/build/dc-toolchain" CACHE PATH "Bare-metal sh4-elf GCC prefix")
set(CMAKE_C_COMPILER "${SHENMUE_DC_TOOLCHAIN_ROOT}/bin/sh4-elf-gcc")
set(CMAKE_CXX_COMPILER "${SHENMUE_DC_TOOLCHAIN_ROOT}/bin/sh4-elf-g++")
set(CMAKE_AR "${SHENMUE_DC_TOOLCHAIN_ROOT}/bin/sh4-elf-ar")
set(CMAKE_RANLIB "${SHENMUE_DC_TOOLCHAIN_ROOT}/bin/sh4-elf-ranlib")
set(CMAKE_OBJCOPY "${SHENMUE_DC_TOOLCHAIN_ROOT}/bin/sh4-elf-objcopy")
set(CMAKE_OBJDUMP "${SHENMUE_DC_TOOLCHAIN_ROOT}/bin/sh4-elf-objdump")
set(CMAKE_C_FLAGS_INIT "-m4-single -ml -O1 -fno-omit-frame-pointer -fno-builtin -ffp-contract=off")
set(CMAKE_CXX_FLAGS_INIT "${CMAKE_C_FLAGS_INIT}")
foreach(_shenmue_language C CXX)
  set(CMAKE_${_shenmue_language}_FLAGS_DEBUG "-g" CACHE STRING "DC Debug flags")
  set(CMAKE_${_shenmue_language}_FLAGS_RELEASE "-DNDEBUG" CACHE STRING "DC Release flags")
  set(CMAKE_${_shenmue_language}_FLAGS_RELWITHDEBINFO "-g -DNDEBUG" CACHE STRING "DC RelWithDebInfo flags")
  set(CMAKE_${_shenmue_language}_FLAGS_MINSIZEREL "-DNDEBUG" CACHE STRING "DC MinSizeRel flags")
endforeach()
set(CMAKE_FIND_ROOT_PATH "${SHENMUE_DC_TOOLCHAIN_ROOT}/sh4-elf")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
