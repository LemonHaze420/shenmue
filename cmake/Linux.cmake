find_package(SDL2 REQUIRED CONFIG)
set(SHENMUE_DXVK_ROOT "" CACHE PATH "dxvk-native installation prefix")
find_path(SHENMUE_DXVK_INCLUDE_DIR d3d11.h HINTS "${SHENMUE_DXVK_ROOT}/include/dxvk" PATH_SUFFIXES dxvk REQUIRED)
find_library(SHENMUE_DXVK_D3D11 NAMES dxvk_d3d11 HINTS "${SHENMUE_DXVK_ROOT}/lib" REQUIRED)
find_library(SHENMUE_DXVK_DXGI NAMES dxvk_dxgi HINTS "${SHENMUE_DXVK_ROOT}/lib" REQUIRED)
add_library(shenmue_dxvk_native INTERFACE)
target_include_directories(shenmue_dxvk_native INTERFACE "${SHENMUE_DXVK_INCLUDE_DIR}")
target_link_libraries(shenmue_dxvk_native INTERFACE "${SHENMUE_DXVK_D3D11}" "${SHENMUE_DXVK_DXGI}")
add_compile_definitions(SHENMUE_GFX_DXVK_NATIVE=1)
