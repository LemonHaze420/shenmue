

#ifndef SCN3_CONTROL
#define SCN3_CONTROL(identifier, operation, mnemonic, name, operands)
#endif
#ifndef SCN3_ADDRESS
#define SCN3_ADDRESS(identifier, operation, mnemonic, name)
#endif
#ifndef SCN3_ALU
#define SCN3_ALU(identifier, operation, mnemonic, name, operands, results, binary)
#endif

SCN3_CONTROL(Return, 0x0, "ctrl.ret", "vm_return", 0)
SCN3_CONTROL(LocalCall, 0x1, "ctrl.local_call", "vm_call", 0)
SCN3_CONTROL(IndirectCall, 0x2, "ctrl.call_indirect_local", "vm_call_indirect", 1)
SCN3_CONTROL(AdjustStack, 0x3, "ctrl.adjust_sp", "vm_adjust_sp", 0)
SCN3_CONTROL(LocalJump, 0x4, "ctrl.jump_local", "vm_goto_local", 0)
SCN3_CONTROL(Jump, 0x5, "ctrl.jump_rel", "vm_goto_rel", 0)
SCN3_CONTROL(BranchFalse, 0x6, "ctrl.branch_false", "vm_branch_false", 0)
SCN3_CONTROL(LatchOperand, 0x7, "ctrl.latch_operand", "vm_set_operand", 0)
SCN3_CONTROL(ScnfOffset, 0x8, "ctrl.call_async_scnf_offset", "vm_scnf_offset", 0)
SCN3_CONTROL(CallLegacy, 0x9, "ctrl.call_legacy", "vm_call_legacy", 0)
SCN3_CONTROL(CallGp, 0xA, "ctrl.call_gp", "vm_call_gp", 0)
SCN3_CONTROL(CallShenmue, 0xB, "ctrl.call_shenmue", "vm_call_shenmue", 0)
SCN3_CONTROL(CallScnf, 0xC, "ctrl.call_scnf", "vm_call_scnf", 0)
SCN3_CONTROL(CallDswk, 0xD, "ctrl.call_dswk", "vm_call_dswk", 0)
SCN3_CONTROL(Control0E, 0xE, "ctrl.op0E", "vm_ctrl_0e", 0)
SCN3_CONTROL(Control0F, 0xF, "ctrl.op0F", "vm_ctrl_0f", 0)

SCN3_ADDRESS(Literal, 0x0, "addr.curr.literal", "vm_literal")
SCN3_ADDRESS(Relative1, 0x1, "addr.curr.rel1", "vm_base_rel1")
SCN3_ADDRESS(Relative2, 0x2, "addr.curr.rel2", "vm_base_rel2")
SCN3_ADDRESS(Relative3, 0x3, "addr.curr.rel3", "vm_base_rel3")
SCN3_ADDRESS(Data8, 0x4, "addr.script_data.idx8", "vm_data8")
SCN3_ADDRESS(Data16, 0x5, "addr.script_data.ld16", "vm_data16")
SCN3_ADDRESS(Data32, 0x6, "addr.script_data.ld32", "vm_data32")
SCN3_ADDRESS(DataAddress, 0x7, "addr.script_data.new_pointer", "vm_data_address")
SCN3_ADDRESS(Task8, 0x8, "addr.scenario_work.idx8", "vm_task8")
SCN3_ADDRESS(Task16, 0x9, "addr.scenario_work.ld16", "vm_task16")
SCN3_ADDRESS(Task32, 0xA, "addr.scenario_work.ld32", "vm_task32")
SCN3_ADDRESS(TaskAddress, 0xB, "addr.scenario_work.new_pointer", "vm_task_address")
SCN3_ADDRESS(Local8, 0xC, "addr.prev_sp.idx8", "vm_local8")
SCN3_ADDRESS(Local16, 0xD, "addr.prev_sp.ld16", "vm_local16")
SCN3_ADDRESS(Local32, 0xE, "addr.prev_sp.ld32", "vm_local32")
SCN3_ADDRESS(LocalAddress, 0xF, "addr.prev_sp.new_pointer", "vm_local_address")

SCN3_ALU(PopEax, 0x00, "alu.pop_eax", "vm_pop_eax", 1, 0, nullptr)
SCN3_ALU(PushEax, 0x01, "alu.push_eax", "eax", 0, 1, nullptr)
SCN3_ALU(Load8, 0x02, "alu.load8", "vm_load8", 1, 1, nullptr)
SCN3_ALU(Load16, 0x03, "alu.load16", "vm_load16", 1, 1, nullptr)
SCN3_ALU(Load32, 0x04, "alu.load32", "vm_load32", 1, 1, nullptr)
SCN3_ALU(Store8, 0x05, "alu.store8", "vm_store8", 2, 1, nullptr)
SCN3_ALU(Store16, 0x06, "alu.store16", "vm_store16", 2, 1, nullptr)
SCN3_ALU(Store32, 0x07, "alu.store32", "vm_store32", 2, 1, nullptr)
SCN3_ALU(Equal, 0x08, "alu.cmp_eq_i", "vm_eq", 2, 1, "==")
SCN3_ALU(NotEqual, 0x09, "alu.cmp_ne_i", "vm_ne", 2, 1, "!=")
SCN3_ALU(Less, 0x0A, "alu.cmp_lt_i", "vm_lt", 2, 1, "<")
SCN3_ALU(LessEqual, 0x0B, "alu.cmp_le_i", "vm_le", 2, 1, "<=")
SCN3_ALU(Greater, 0x0C, "alu.cmp_gt_i", "vm_gt", 2, 1, ">")
SCN3_ALU(GreaterEqual, 0x0D, "alu.cmp_ge_i", "vm_ge", 2, 1, ">=")
SCN3_ALU(Not, 0x0E, "alu.bit_not", "vm_not", 1, 1, nullptr)
SCN3_ALU(And, 0x0F, "alu.and_i", "vm_and", 2, 1, "&")
SCN3_ALU(Or, 0x10, "alu.or_i", "vm_or", 2, 1, "|")
SCN3_ALU(Xor, 0x11, "alu.xor_i", "vm_xor", 2, 1, "^")
SCN3_ALU(Add, 0x12, "alu.add_i", "vm_add", 2, 1, "+")
SCN3_ALU(Subtract, 0x13, "alu.sub_i", "vm_sub", 2, 1, "-")
SCN3_ALU(Multiply, 0x14, "alu.mul_i", "vm_mul", 2, 1, "*")
SCN3_ALU(Divide, 0x15, "alu.div_i", "vm_div", 2, 1, "/")
SCN3_ALU(Modulo, 0x16, "alu.mod_i", "vm_mod", 2, 1, "%")
SCN3_ALU(ShiftLeft, 0x17, "alu.shl_i", "vm_shl", 2, 1, "<<")
SCN3_ALU(ShiftRight, 0x18, "alu.shr_i", "vm_shr", 2, 1, ">>")
SCN3_ALU(Reserved19, 0x19, nullptr, "vm_alu_19", 0, 0, nullptr)
SCN3_ALU(Reserved1A, 0x1A, nullptr, "vm_alu_1a", 0, 0, nullptr)
SCN3_ALU(Reserved1B, 0x1B, nullptr, "vm_alu_1b", 0, 0, nullptr)
SCN3_ALU(Reserved1C, 0x1C, nullptr, "vm_alu_1c", 0, 0, nullptr)
SCN3_ALU(IntToFloat, 0x1D, "alu.int_to_float", "vm_int_to_float", 1, 1, nullptr)
SCN3_ALU(FloatToInt, 0x1E, "alu.float_to_int", "vm_float_to_int", 1, 1, nullptr)
SCN3_ALU(FloatLess, 0x1F, "alu.cmp_lt_f", "vm_flt", 2, 1, nullptr)
SCN3_ALU(FloatLessEqual, 0x20, "alu.cmp_le_f", "vm_fle", 2, 1, nullptr)
SCN3_ALU(FloatGreater, 0x21, "alu.cmp_gt_f", "vm_fgt", 2, 1, nullptr)
SCN3_ALU(FloatGreaterEqual, 0x22, "alu.cmp_ge_f", "vm_fge", 2, 1, nullptr)
SCN3_ALU(FloatAdd, 0x23, "alu.add_f", "vm_fadd", 2, 1, nullptr)
SCN3_ALU(FloatSubtract, 0x24, "alu.sub_f", "vm_fsub", 2, 1, nullptr)
SCN3_ALU(FloatMultiply, 0x25, "alu.mul_f", "vm_fmul", 2, 1, nullptr)
SCN3_ALU(FloatDivide, 0x26, "alu.div_f", "vm_fdiv", 2, 1, nullptr)

#undef SCN3_CONTROL
#undef SCN3_ADDRESS
#undef SCN3_ALU
