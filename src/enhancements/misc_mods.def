SHEN_MOD(RainLevel, Slider, Weather, "RainLevel", "Rain override", "Rain intensity when Override weather is enabled.", 0, 0, 100)
SHEN_MOD(SnowLevel, Slider, Weather, "SnowLevel", "Snow override", "Snow intensity when Override weather is enabled.", 0, 0, 100)
